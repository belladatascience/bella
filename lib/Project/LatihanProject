            const [activeReceipt, setActiveReceipt] = useState(null);
            const [showReceiptModal, setShowReceiptModal] = useState(false);

            // PPT Presentation State
            const [currentSlide, setCurrentSlide] = useState(0);

            // Format Currency
            const formatRp = (amount) => {
                return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(amount);
            };

            // Add item to cart
            const addToCart = (item) => {
                if (item.stock <= 0) return;
                setCart(prev => {
                    const existing = prev.find(i => i.id === item.id);
                    if (existing) {
                        if (existing.qty >= item.stock) return prev;
                        return prev.map(i => i.id === item.id ? { ...i, qty: i.qty + 1 } : i);
                    }
                    return [...prev, { ...item, qty: 1, note: '' }];
                });
            };

            // Update qty in cart
            const updateCartQty = (id, delta) => {
                setCart(prev => {
                    return prev.map(item => {
                        if (item.id === id) {
                            const newQty = item.qty + delta;
                            if (newQty <= 0) return null;
                            const menuItem = menuItems.find(m => m.id === id);
                            if (menuItem && newQty > menuItem.stock) return item;
                            return { ...item, qty: newQty };
                        }
                        return item;
                    }).filter(Boolean);
                });
            };

            // Update note for cart item
            const updateCartNote = (id, note) => {
                setCart(prev => prev.map(i => i.id === id ? { ...i, note } : i));
            };

            // Calculation
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            const tax = Math.round(subtotal * 0.1); // PB1 10%
            const grandTotal = subtotal + tax;
            const cashVal = parseFloat(cashTendered) || 0;
            const changeVal = cashVal >= grandTotal ? cashVal - grandTotal : 0;

            // Process Transaction
            const handleCheckout = () => {
                if (cart.length === 0) return;
                if (payMethod === 'Tunai' && cashVal < grandTotal) {
                    alert('Nominal uang tunai kurang dari total pembayaran!');
                    return;
                }

                const newTransaction = {
                    id: 'CL-' + Math.floor(1000 + Math.random() * 9000),
                    datetime: new Date().toLocaleString('sv-SE').replace('T', ' ').substring(0, 16),
                    cashier: 'Bella Gita Asmara',
                    customer: customerName.trim() || 'Pelanggan',
                    items: cart.map(i => ({ name: i.name, qty: i.qty, price: i.price, note: i.note })),
                    subtotal,
                    tax,
                    total: grandTotal,
                    payMethod,
                    cashTendered: payMethod === 'Tunai' ? cashVal : grandTotal,
                    change: payMethod === 'Tunai' ? changeVal : 0
                };

                // Update stock
                setMenuItems(prev => prev.map(m => {
                    const cartItem = cart.find(c => c.id === m.id);
                    if (cartItem) {
                        return { ...m, stock: m.stock - cartItem.qty };
                    }
                    return m;
                }));

                // Save transaction
                setTransactions([newTransaction, ...transactions]);
                setActiveReceipt(newTransaction);
                setShowReceiptModal(true);

                // Reset cart
                setCart([]);
                setCashTendered('');
                setCustomerName('');
            };

            // Filter menu items
            const filteredMenu = menuItems.filter(item => {
                const matchCategory = selectedCategory === 'Semua' || item.category === selectedCategory;
                const matchSearch = item.name.toLowerCase().includes(searchQuery.toLowerCase());
                return matchCategory && matchSearch;
            });

