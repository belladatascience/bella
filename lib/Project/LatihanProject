                                        <p className="text-[10px] text-slate-400">Jl. Kopi Harapan No. 12, Jakarta</p>
                                    </div>

                                    <div className="text-left text-xs space-y-1 text-slate-600">
                                        <div className="flex justify-between">
                                            <span>ID Order:</span>
                                            <span className="font-bold text-slate-800">{activeReceipt.id}</span>
                                        </div>
                                        <div className="flex justify-between">
                                            <span>Waktu:</span>
                                            <span>{activeReceipt.datetime}</span>
                                        </div>
                                        <div className="flex justify-between">
                                            <span>Kasir:</span>
                                            <span>{activeReceipt.cashier}</span>
                                        </div>
                                        <div className="flex justify-between">
                                            <span>Pelanggan:</span>
                                            <span className="font-semibold text-slate-800">{activeReceipt.customer}</span>
                                        </div>
                                    </div>

                                    {/* Itemized Receipt */}
                                    <div className="border-t border-b border-dashed border-slate-300 py-2 space-y-1 text-xs text-left">
                                        {activeReceipt.items.map((item, idx) => (
                                            <div key={idx} className="space-y-0.5">
                                                <div className="flex justify-between font-semibold text-slate-800">
                                                    <span>{item.name} x{item.qty}</span>
                                                    <span>{formatRp(item.price * item.qty)}</span>
                                                </div>
                                                {item.note && <p className="text-[10px] text-slate-400 italic">Note: {item.note}</p>}
                                            </div>
                                        ))}
                                    </div>

                                    {/* Summary */}
                                    <div className="text-xs space-y-1 text-right text-slate-600">
                                        <div className="flex justify-between">
                                            <span>Subtotal</span>
                                            <span>{formatRp(activeReceipt.subtotal)}</span>
                                        </div>
                                        <div className="flex justify-between">
                                            <span>Pajak PB1 (10%)</span>
                                            <span>{formatRp(activeReceipt.tax)}</span>
                                        </div>
                                        <div className="flex justify-between text-sm font-extrabold text-slate-900 border-t border-slate-200 pt-1">
                                            <span>TOTAL</span>
                                            <span className="text-amber-900">{formatRp(activeReceipt.total)}</span>
                                        </div>
                                        <div className="flex justify-between text-[11px] pt-1">
                                            <span>Metode Bayar:</span>
                                            <span className="font-bold">{activeReceipt.payMethod}</span>
                                        </div>
                                        {activeReceipt.payMethod === 'Tunai' && (
                                            <>
                                                <div className="flex justify-between text-[11px]">
                                                    <span>Tunai Diterima:</span>
                                                    <span>{formatRp(activeReceipt.cashTendered)}</span>
                                                </div>
                                                <div className="flex justify-between text-[11px] font-bold text-emerald-700">
                                                    <span>Kembalian:</span>
                                                    <span>{formatRp(activeReceipt.change)}</span>
                                                </div>
                                            </>
                                        )}
                                    </div>

                                    <div className="pt-2 border-t border-dashed border-slate-300 text-center space-y-1">
                                        <p className="text-[11px] font-bold text-slate-700">Terima Kasih Atas Kunjungan Anda!</p>
                                        <p className="text-[10px] text-slate-400">Kasir Digital Cashier Latte • Bella Gita Asmara</p>
                                    </div>
                                </div>

                                <div className="flex gap-2 pt-2">
                                    <button 
                                        onClick={() => window.print()}
                                        className="flex-1 py-2 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-xl text-xs transition flex items-center justify-center gap-2 shadow"
                                    >
                                        <i className="fa-solid fa-print"></i> Cetak Struk
                                    </button>
                                    <button 
                                        onClick={() => setShowReceiptModal(false)}
                                        className="py-2 px-4 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold rounded-xl text-xs transition"
                                    >
                                        Tutup
                                    </button>
                                </div>
                            </div>
                        </div>
                    )}
                </div>
            );
        }

        ReactDOM.createRoot(document.getElementById('root')).render(<App />);
    </script>
</body>
</html>